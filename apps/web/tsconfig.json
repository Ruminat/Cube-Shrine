{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "target": "ES2017",
    "noEmit": true,
    "module": "esnext",
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@shreklabs/cube-shrine/react": ["../../packages/cube-shrine/src/entry-react.ts"],
      "@shreklabs/cube-shrine/render": ["../../packages/cube-shrine/src/entry-render.ts"],
      "@shreklabs/cube-shrine/core": ["../../packages/cube-shrine/src/entry-core.ts"],
      "@shreklabs/cube-shrine": ["../../packages/cube-shrine/src/entry-index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
