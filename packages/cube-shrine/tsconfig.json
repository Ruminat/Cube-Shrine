{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../apps/web/*"],
      "@shreklabs/cube-shrine": ["./src/entry-index.ts"],
      "@shreklabs/cube-shrine/core": ["./src/entry-core.ts"],
      "@shreklabs/cube-shrine/render": ["./src/entry-render.ts"],
      "@shreklabs/cube-shrine/react": ["./src/entry-react.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "vite.*.config.ts",
    "vite.lib.shared.ts",
    "vitest.config.ts",
    "tsconfig.build-dts.json"
  ]
}
